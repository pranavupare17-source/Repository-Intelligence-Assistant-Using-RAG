# Gemini Embedding API Key (Optional if using OpenAI or Mock)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI Embedding API Key (Optional if using Gemini or Mock)
OPENAI_API_KEY=your_openai_api_key_here

# Embedding Provider: 'gemini', 'openai', or 'mock' (default: mock if no keys set)
EMBEDDING_PROVIDER=mock
